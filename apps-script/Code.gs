const DATABASE_ID = '1f_qveJu-Q0b9PiwrV1JDGCPeTytZOwhso0KHNTxzOoY';
const STORE_OPTIONS = [{"id":"sheet-oo-14","name":"義麵寶寶"},{"id":"sheet-oo-15","name":"卜乘滷味"},{"id":"sheet1-029","name":"純愛小吃"},{"id":"sheet-oo-31","name":"敘方"},{"id":"sheet-oo-38","name":"誠品書局"},{"id":"jian-yi-mian-huaxin","name":"見一面"},{"id":"sheet-oo-57","name":"山摺山甜點"},{"id":"sheet-oo-65","name":"肉骨潘"},{"id":"sheet-oo-67","name":"蓋厚茶"},{"id":"sheet-oo-69","name":"鼎豐加熱滷味"},{"id":"sheet-oo-71","name":"泰好早"},{"id":"sheet-oo-76","name":"umai我賣車輪餅(公館夜市)"},{"id":"oo-tower-lucky","name":"Tower Lucky"},{"id":"oo-one-tingzhou","name":"One桌遊 汀州店"}];
const WISH_TYPES = ['想合作的店家','想要的優惠','網站建議'];
const HEADERS = ['id','createdAt','status','storeId','storeName','nickname','rating','type','content','requestId'];
function setupCommunity(){const ss=SpreadsheetApp.openById(DATABASE_ID);['Reviews','Wishes'].forEach(name=>{let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(!s.getLastRow()){s.appendRow(HEADERS);s.setFrozenRows(1);s.getRange(1,1,1,HEADERS.length).setBackground('#BA3E25').setFontColor('#FFFFFF').setFontWeight('bold');s.setColumnWidth(9,420);s.getRange('C2:C10000').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['pending','approved','hidden'],true).setAllowInvalid(false).build());}else if(JSON.stringify(s.getRange(1,1,1,HEADERS.length).getValues()[0])!==JSON.stringify(HEADERS))throw Error(name+' 欄位不符，請勿覆蓋既有資料');});return '資料庫已就緒';}
function doGet(e){const id=String(e&&e.parameter&&e.parameter.storeId||'');return HtmlService.createHtmlOutput(PAGE_HTML.replace('__INITIAL_STORE__',JSON.stringify(STORE_OPTIONS.some(s=>s.id===id)?id:''))).setTitle('臺科特約留言與許願').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function readRows_(name){const s=SpreadsheetApp.openById(DATABASE_ID).getSheetByName(name);if(!s)throw Error('資料庫尚未初始化');const last=s.getLastRow();if(last<2)return [];const start=Math.max(2,last-1999);return s.getRange(start,1,last-start+1,HEADERS.length).getValues();}
function getCommunity(){return {reviews:readRows_('Reviews').filter(r=>r[2]==='approved').slice(-200).reverse().map(publicRow_),wishes:readRows_('Wishes').filter(r=>r[2]==='approved').slice(-200).reverse().map(publicRow_)};}
function publicRow_(r){return {id:String(r[0]),date:r[1] instanceof Date?r[1].toISOString():String(r[1]),storeId:String(r[3]),storeName:String(r[4]),nickname:String(r[5]),rating:Number(r[6])||0,type:String(r[7]),content:String(r[8])};}
function clean_(v,max){if(typeof v!=='string')throw Error('資料格式不正確');const s=v.trim();if(!s||s.length>max)throw Error('請確認必填欄位與字數');return s;}
function literal_(s){return /^[=+\-@\t\r]/.test(s)?"'"+s:s;}
function submitCommunity(p){if(!p||p.website)throw Error('無法送出');if(!['review','wish'].includes(p.kind))throw Error('類型不正確');const nickname=clean_(p.nickname,30),content=clean_(p.content,1000),requestId=clean_(p.requestId,80),client=clean_(p.clientId,80);if(!/^[a-zA-Z0-9-]{16,80}$/.test(requestId)||!/^[a-zA-Z0-9-]{16,80}$/.test(client))throw Error('請重新整理後再試');const store=STORE_OPTIONS.find(s=>s.id===p.storeId);let rating=0,type='';if(p.kind==='review'){rating=Number(p.rating);if(!store||!Number.isInteger(rating)||rating<1||rating>5)throw Error('請選擇店家及1至5顆星');}else{type=clean_(p.type,30);if(!WISH_TYPES.includes(type))throw Error('請選擇許願分類');}const lock=LockService.getScriptLock();lock.waitLock(10000);try{const name=p.kind==='review'?'Reviews':'Wishes';if(readRows_(name).some(r=>r[9]===requestId))return {ok:true,message:'這筆內容已送出，等待審核。'};const cache=CacheService.getScriptCache(),key='submit:'+client;if(cache.get(key))throw Error('送出太頻繁，請稍候一分鐘再試');const sheet=SpreadsheetApp.openById(DATABASE_ID).getSheetByName(name);sheet.appendRow([Utilities.getUuid(),new Date(),'pending',store?store.id:'',store?store.name:'',literal_(nickname),rating,type,literal_(content),requestId]);cache.put(key,'1',60);return {ok:true,message:'已送出！學生會審核後會公開顯示。'};}finally{lock.releaseLock();}}
const PAGE_HTML = "<!doctype html><html lang=\"zh-Hant\"><head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>\n*{box-sizing:border-box}body{margin:0;padding:22px;background:#fffaf1;color:#39251d;font:15px/1.7 Arial,\"Microsoft JhengHei\",sans-serif}button,select,input,textarea{font:inherit}button{cursor:pointer;min-height:44px;border-radius:8px;border:1px solid #d8bda5;padding:9px 18px;background:white;color:#84341e}button[aria-selected=true],button[type=submit]{background:#ba3e25;color:white;border-color:#ba3e25}.tabs{display:flex;gap:10px;margin-bottom:20px}h2{font-size:24px;margin:8px 0}p{margin:8px 0 16px}.layout{display:grid;grid-template-columns:1fr 1fr;gap:24px}form,.feed{padding:22px;border:1px solid #e7d8c8;border-radius:14px;background:#fffdf8;min-width:0}label{display:block;margin:12px 0 6px;font-weight:bold}input,textarea,select{width:100%;padding:10px;border:1px solid #cfb9a5;border-radius:7px;background:white;color:#39251d}textarea{resize:vertical;min-height:130px}.stars{display:flex;gap:8px;flex-wrap:wrap;border:0;padding:0;margin:12px 0}.stars label{margin:0;cursor:pointer;display:flex;align-items:center;gap:3px;color:#9b391d}.stars input{width:auto;accent-color:#ba3e25}.hint{font-size:12px;color:#76604f}article{border-bottom:1px solid #e7d8c8;padding:16px 0}article p{white-space:pre-wrap;overflow-wrap:anywhere}article small{color:#76604f}.status{min-height:26px;color:#8f341e}.hp{position:absolute;left:-10000px}button:disabled{opacity:.5;cursor:wait}[hidden]{display:none!important}:focus-visible{outline:3px solid #ba3e25;outline-offset:3px}@media(max-width:700px){body{padding:12px}.layout{grid-template-columns:1fr}form,.feed{padding:16px}}\n</style></head><body><div class=\"tabs\" role=\"tablist\" aria-label=\"留言與許願\"><button id=\"review-tab\" role=\"tab\" aria-selected=\"true\" aria-controls=\"review-panel\">店家留言與評分</button><button id=\"wish-tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"wish-panel\">特約許願</button></div><p class=\"hint\">暱稱、內容與評分審核後公開。請勿填寫電話、學號或其他個人資料。資料儲存在學生會指定的 Google 試算表。</p>\n<section id=\"review-panel\" role=\"tabpanel\"><h2>吃過、去過，分享你的心得</h2><div class=\"layout\"><form id=\"review-form\"><label for=\"review-store\">選擇店家</label><select id=\"review-store\" name=\"storeId\" required></select><label for=\"review-name\">暱稱</label><input id=\"review-name\" name=\"nickname\" maxlength=\"30\" required autocomplete=\"nickname\"><fieldset class=\"stars\"><legend>你的評分</legend><label><input type=\"radio\" name=\"rating\" value=\"1\" required>1 ★</label><label><input type=\"radio\" name=\"rating\" value=\"2\">2 ★</label><label><input type=\"radio\" name=\"rating\" value=\"3\">3 ★</label><label><input type=\"radio\" name=\"rating\" value=\"4\">4 ★</label><label><input type=\"radio\" name=\"rating\" value=\"5\">5 ★</label></fieldset><label for=\"review-text\">用餐或服務心得</label><textarea id=\"review-text\" name=\"content\" maxlength=\"1000\" required placeholder=\"分享餐點、服務或優惠使用經驗（最多1000字）\"></textarea><label class=\"hp\" aria-hidden=\"true\">保留空白<input name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><button type=\"submit\">送出留言</button><p class=\"status\" role=\"status\"></p></form><div class=\"feed\"><label for=\"read-store\">查看店家評論</label><select id=\"read-store\"></select><p id=\"rating-summary\"></p><div id=\"reviews\" aria-live=\"polite\">載入中…</div></div></div></section>\n<section id=\"wish-panel\" role=\"tabpanel\" hidden><h2>下一間特約，由你提名</h2><div class=\"layout\"><form id=\"wish-form\"><label for=\"wish-type\">選擇許願分類</label><select id=\"wish-type\" name=\"type\" required><option value=\"\">請選擇</option><option>想合作的店家</option><option>想要的優惠</option><option>網站建議</option></select><label for=\"wish-store\">相關店家（選填）</label><select id=\"wish-store\" name=\"storeId\"></select><label for=\"wish-name\">暱稱</label><input id=\"wish-name\" name=\"nickname\" maxlength=\"30\" required><label for=\"wish-text\">你的願望</label><textarea id=\"wish-text\" name=\"content\" maxlength=\"1000\" required placeholder=\"想合作的店名、地區，或期待的優惠（最多1000字）\"></textarea><label class=\"hp\" aria-hidden=\"true\">保留空白<input name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label><button type=\"submit\">送出願望</button><p class=\"status\" role=\"status\"></p></form><div class=\"feed\"><label for=\"read-type\">查看許願分類</label><select id=\"read-type\"><option value=\"\">全部分類</option><option>想合作的店家</option><option>想要的優惠</option><option>網站建議</option></select><div id=\"wishes\" aria-live=\"polite\">載入中…</div></div></div></section><button id=\"refresh\" type=\"button\">重新載入留言</button><p id=\"load-status\" role=\"status\"></p>\n<script>\nconst stores=[{\"id\":\"sheet-oo-14\",\"name\":\"義麵寶寶\"},{\"id\":\"sheet-oo-15\",\"name\":\"卜乘滷味\"},{\"id\":\"sheet1-029\",\"name\":\"純愛小吃\"},{\"id\":\"sheet-oo-31\",\"name\":\"敘方\"},{\"id\":\"sheet-oo-38\",\"name\":\"誠品書局\"},{\"id\":\"jian-yi-mian-huaxin\",\"name\":\"見一面\"},{\"id\":\"sheet-oo-57\",\"name\":\"山摺山甜點\"},{\"id\":\"sheet-oo-65\",\"name\":\"肉骨潘\"},{\"id\":\"sheet-oo-67\",\"name\":\"蓋厚茶\"},{\"id\":\"sheet-oo-69\",\"name\":\"鼎豐加熱滷味\"},{\"id\":\"sheet-oo-71\",\"name\":\"泰好早\"},{\"id\":\"sheet-oo-76\",\"name\":\"umai我賣車輪餅(公館夜市)\"},{\"id\":\"oo-tower-lucky\",\"name\":\"Tower Lucky\"},{\"id\":\"oo-one-tingzhou\",\"name\":\"One桌遊 汀州店\"}],q=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));let data={reviews:[],wishes:[]};const options=stores.map(s=>'<option value=\"'+esc(s.id)+'\">'+esc(s.name)+'</option>').join('');q('#review-store').innerHTML='<option value=\"\">請選擇店家</option>'+options;q('#read-store').innerHTML='<option value=\"\">全部店家</option>'+options;q('#wish-store').innerHTML='<option value=\"\">新店家／不指定（請在內容填寫）</option>'+options;function tab(kind){for(const k of ['review','wish']){q('#'+k+'-panel').hidden=k!==kind;q('#'+k+'-tab').setAttribute('aria-selected',String(k===kind));}}q('#review-tab').onclick=()=>tab('review');q('#wish-tab').onclick=()=>tab('wish');\nfunction render(){const reviews=data.reviews.filter(r=>!q('#read-store').value||r.storeId===q('#read-store').value),wishes=data.wishes.filter(r=>!q('#read-type').value||r.type===q('#read-type').value);q('#rating-summary').textContent=reviews.length?'★ '+(reviews.reduce((n,r)=>n+r.rating,0)/reviews.length).toFixed(1)+' / 5 · '+reviews.length+' 則已審核評論（最近200則範圍）':'尚無已審核評分';function card(r,review){return '<article><strong>'+esc(review?r.storeName:r.type)+'</strong><p>'+esc(r.content)+'</p><small>'+esc(r.nickname)+(review?' · '+r.rating+' ★':'')+' · '+esc(new Date(r.date).toLocaleDateString('zh-TW',{timeZone:'Asia/Taipei'}))+'</small></article>';}q('#reviews').innerHTML=reviews.map(r=>card(r,true)).join('')||'<p>還沒有公開留言，來分享第一則心得吧。</p>';q('#wishes').innerHTML=wishes.map(r=>card(r,false)).join('')||'<p>還沒有公開願望，來提名你期待的特約吧。</p>';}\nfunction refresh(){q('#refresh').disabled=true;q('#load-status').textContent='讀取中…';google.script.run.withSuccessHandler(d=>{data=d;render();q('#refresh').disabled=false;q('#load-status').textContent='已更新';}).withFailureHandler(()=>{q('#refresh').disabled=false;q('#load-status').textContent='暫時無法載入，請稍後重試。';}).getCommunity();}q('#refresh').onclick=refresh;q('#read-store').onchange=render;q('#read-type').onchange=render;\nlet clientId=crypto.randomUUID();try{clientId=localStorage.getItem('perks-community-client')||clientId;localStorage.setItem('perks-community-client',clientId)}catch{}for(const kind of ['review','wish']){const form=q('#'+kind+'-form');let requestId=crypto.randomUUID();form.addEventListener('input',()=>requestId=crypto.randomUUID());form.onsubmit=e=>{e.preventDefault();if(!form.reportValidity())return;const payload=Object.fromEntries(new FormData(form));Object.assign(payload,{kind,requestId,clientId});const button=form.querySelector('button[type=submit]'),status=form.querySelector('.status');button.disabled=true;status.textContent='送出中…';google.script.run.withSuccessHandler(r=>{status.textContent=r.message;button.disabled=false;form.reset();requestId=crypto.randomUUID();}).withFailureHandler(e=>{status.textContent=e.message||'送出失敗，內容已保留，請重試。';button.disabled=false;}).submitCommunity(payload);};}\nwindow.addEventListener('message',e=>{if(e.origin!=='https://hankhsu33.github.io')return;if(e.data?.type==='select-store'&&stores.some(s=>s.id===e.data.id)){tab('review');q('#review-store').value=e.data.id;q('#read-store').value=e.data.id;render();}});const initialStore=__INITIAL_STORE__;if(stores.some(s=>s.id===initialStore)){q('#review-store').value=initialStore;q('#read-store').value=initialStore;}refresh();\n</script></body></html>\r\n";
